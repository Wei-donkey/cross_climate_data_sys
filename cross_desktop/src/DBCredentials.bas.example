Attribute VB_Name = "DBCredentials"
' Sample file – please make a copy and save it as DBCredentials.bas (in the same directory as this file),
' then enter your actual database/FTP username and password below. DBCredentials.bas has been added to .gitignore,
' so it will not be committed to the code repository; please keep a backup in a safe place (do not share it via a public repository).

Public Function GetOracleUser(ByVal ConnIndex As Integer) As String
  Select Case ConnIndex
    Case 1: GetOracleUser = ""
    Case 2: GetOracleUser = ""
    Case 3: GetOracleUser = ""
    Case 4: GetOracleUser = ""
  End Select
End Function

Public Function GetOraclePwd(ByVal ConnIndex As Integer) As String
  Select Case ConnIndex
    Case 1: GetOraclePwd = ""
    Case 2: GetOraclePwd = ""
    Case 3: GetOraclePwd = ""
    Case 4: GetOraclePwd = ""
  End Select
End Function

Public Function GetFTPUser() As String
  GetFTPUser = ""
End Function

Public Function GetFTPPwd() As String
  GetFTPPwd = ""
End Function
